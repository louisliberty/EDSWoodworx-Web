{%- comment -%}
  Usage: {% render 'icon', name: 'cart' %}
  All icons are decorative (aria-hidden); the surrounding control carries the accessible name.
{%- endcomment -%}
{%- case name -%}
  {%- when 'ring' -%}
    <svg class="ring-mark" viewBox="0 0 48 48" fill="none" stroke="currentColor" aria-hidden="true" focusable="false"><circle cx="24" cy="24" r="22" stroke-width="2.4"/><ellipse cx="22.4" cy="25.4" rx="15.6" ry="14.8" stroke-width="1.6"/><ellipse cx="21.4" cy="26.2" rx="10.6" ry="10" stroke-width="1.6"/><ellipse cx="20.6" cy="26.8" rx="5.8" ry="5.4" stroke-width="1.6"/><circle cx="20.2" cy="27.1" r="1.5" fill="currentColor" stroke="none"/><path d="M22.2 25.1 33.8 13.6" stroke-width="1.6" stroke-linecap="round"/></svg>
  {%- when 'ring-small' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"/><ellipse cx="11.2" cy="12.8" rx="6.2" ry="5.8"/><circle cx="10.6" cy="13.3" r="1.6" fill="currentColor" stroke="none"/></svg>
  {%- when 'clock' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9.5"/><path d="M12 6.5V12l3.5 2.5"/></svg>
  {%- when 'info' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9.5"/><path d="M12 11v6M12 7.5v.01"/></svg>
  {%- when 'alert' -%}
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M12 3 2 20h20L12 3z"/><path d="M12 10v4M12 17v.01"/></svg>
  {%- when 'search' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg>
