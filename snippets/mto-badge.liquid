{%- comment -%}
  Made-to-order status badge. Text always carries the meaning (never color alone).
  Usage: {% render 'mto-badge', product: product %}
  A product shows "Ready to ship" only when metafield custom.ready_to_ship is true.
{%- endcomment -%}
{%- if product and product.available == false -%}
  <span class="mto-badge mto-badge--unavailable">{% render 'icon', name: 'info' %}Currently unavailable</span>
{%- elsif product and product.metafields.custom.ready_to_ship.value == true -%}
  <span class="mto-badge mto-badge--ready">{% render 'icon', name: 'check' %}Ready to ship</span>
{%- else -%}
  <span class="mto-badge">{% render 'icon', name: 'ring-small' %}Made to order</span>
{%- endif -%}
