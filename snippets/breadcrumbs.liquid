{%- comment -%} Visible breadcrumbs + BreadcrumbList JSON-LD for product and collection pages. {%- endcomment -%}
{%- liquid
  assign coll = collection
  if template.name == 'product' and coll == blank
    assign coll = product.collections | where: 'handle', product.metafields.custom.primary_collection.value.handle | first
    if coll == blank
      assign coll = product.collections.first
    endif
  endif
-%}
<nav class="breadcrumbs page-width" aria-label="Breadcrumb">
  <ol>
    <li><a href="{{ routes.root_url }}">Home</a></li>
    {%- if template.name == 'product' -%}
      {%- if coll -%}<li><a href="{{ coll.url }}">{{ coll.title }}</a></li>{%- endif -%}
      <li><span aria-current="page">{{ product.title }}</span></li>
    {%- elsif template.name == 'collection' -%}
      <li><a href="{{ routes.all_products_collection_url }}">Shop</a></li>
      {%- unless collection.handle == 'all' -%}<li><span aria-current="page">{{ collection.title }}</span></li>{%- endunless -%}
    {%- endif -%}
  </ol>
</nav>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | append: routes.root_url | json }} }
    {%- if template.name == 'product' -%}
      {%- if coll -%}, { "@type": "ListItem", "position": 2, "name": {{ coll.title | json }}, "item": {{ shop.url | append: coll.url | json }} }{%- endif -%}
      , { "@type": "ListItem", "position": {% if coll %}3{% else %}2{% endif %}, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
    {%- elsif template.name == 'collection' -%}
      , { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }} }
    {%- endif -%}
  ]
}
</script>
