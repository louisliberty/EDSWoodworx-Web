{%- comment -%} Product card: image, category context, name, price, made-to-order badge. One link per card. {%- endcomment -%}
{%- assign category = product.metafields.custom.category_label.value | default: product.type -%}
<article class="card">
  {%- if product.featured_media -%}
    {% render 'responsive-image', image: product.featured_media.preview_image, sizes: '(min-width: 1200px) 25vw, (min-width: 990px) 33vw, (min-width: 481px) 50vw, 100vw', ratio: 'square' %}
  {%- else -%}
    {% render 'placeholder-media', label: product.title, ratio: 'square' %}
  {%- endif -%}
  {%- if category != blank -%}<p class="card__category">{{ category }}</p>{%- endif -%}
  <h3 class="card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
  <div class="card__meta">
    {% render 'price', product: product %}
    {% render 'mto-badge', product: product %}
  </div>
</article>
