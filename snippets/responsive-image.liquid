{%- comment -%}
  Responsive image with srcset; Shopify's CDN serves WebP/AVIF automatically where supported.
  Usage: {% render 'responsive-image', image: img, sizes: '(min-width: 990px) 33vw, 50vw', eager: false, ratio: 'square' %}
{%- endcomment -%}
<div class="media media--{{ ratio | default: 'square' }}">
  {%- liquid
    assign loading = 'lazy'
    assign priority = 'auto'
    if eager
      assign loading = 'eager'
      assign priority = 'high'
    endif
    assign alt_text = alt | default: image.alt | default: ''
    if decorative
      assign alt_text = ''
    endif
  -%}
  {{ image | image_url: width: 1800 | image_tag:
    widths: '360, 540, 720, 900, 1200, 1500, 1800',
    sizes: sizes,
    loading: loading,
    fetchpriority: priority,
    alt: alt_text
  }}
</div>
