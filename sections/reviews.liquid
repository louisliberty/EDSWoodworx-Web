{%- comment -%}
  Genuine customer reviews only. Section renders nothing until it is switched on AND has at least one review block.
  If a reviews app is installed later, remove this section and use the app's block instead.
{%- endcomment -%}
{%- if section.settings.enabled and section.blocks.size > 0 -%}
<section class="section section--parchment" aria-labelledby="RevHead-{{ section.id }}">
  <div class="page-width">
    <div class="section__head"><h2 id="RevHead-{{ section.id }}">{{ section.settings.heading }}</h2></div>
    <ul class="grid grid--3" role="list" style="list-style:none;padding:0;margin:0">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <blockquote class="review">
            <p>{{ block.settings.quote }}</p>
            <footer>{{ block.settings.name }}{% if block.settings.product != blank %}, on {{ block.settings.product }}{% endif %}</footer>
          </blockquote>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Customer reviews",
  "settings": [
    { "type": "paragraph", "content": "Add only real reviews, copied word for word, with the customer's permission to share their first name." },
    { "type": "checkbox", "id": "enabled", "label": "Show reviews", "default": false },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What customers say" }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "textarea", "id": "quote", "label": "Review text (exact words)" },
      { "type": "text", "id": "name", "label": "Name (e.g. Linda R.)" },
      { "type": "text", "id": "product", "label": "Product (optional)" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Customer reviews" }]
}
{% endschema %}
