<section class="section" aria-labelledby="CatHead-{{ section.id }}">
  <div class="page-width">
    <div class="section__head">
      <h2 id="CatHead-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <ul class="grid grid--3" role="list" style="list-style:none;padding:0;margin:0">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- assign url = c.url | default: block.settings.fallback_url | default: routes.all_products_collection_url -%}
        {%- assign title = block.settings.title | default: c.title -%}
        {%- assign img = block.settings.image | default: c.featured_image -%}
        <li {{ block.shopify_attributes }}>
          <a class="category-tile" href="{{ url }}">
            {%- if img -%}
              {% render 'responsive-image', image: img, sizes: '(min-width: 750px) 33vw, 100vw', ratio: 'portrait', decorative: true %}
            {%- else -%}
              {% render 'placeholder-media', label: block.settings.placeholder_label, ratio: 'portrait' %}
            {%- endif -%}
            <h3>{{ title }}</h3>
            <p>{{ block.settings.text }}</p>
            <span class="category-tile__cta">Shop {{ title | downcase }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{% schema %}
{
  "name": "Shop by category",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "text", "id": "subheading", "label": "Subheading" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title (optional)" },
        { "type": "text", "id": "text", "label": "Description" },
        { "type": "image_picker", "id": "image", "label": "Image (optional)", "info": "Defaults to the collection image." },
        { "type": "text", "id": "fallback_url", "label": "Link if no collection is chosen" },
        { "type": "text", "id": "placeholder_label", "label": "Photo placeholder label", "default": "Category photo" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Shop by category" }]
}
{% endschema %}
