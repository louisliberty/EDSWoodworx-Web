<div class="page-width page-head">
  <h1>Search</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form" style="max-width:40rem">
    <input type="hidden" name="type" value="product,page,article">
    <input type="hidden" name="options[prefix]" value="last">
    <div class="field">
      <label for="SearchPageInput" class="visually-hidden">Search products and pages</label>
      <input type="search" id="SearchPageInput" name="q" value="{{ search.terms | escape }}" placeholder="Search pens, bowls, boards, FAQ…">
    </div>
    <button type="submit" class="button">Search</button>
  </form>
</div>
<div class="page-width" style="padding-bottom:var(--s-8)">
  {%- if search.performed -%}
    <p role="status">{{ search.results_count }} {{ search.results_count | pluralize: 'result', 'results' }} for “{{ search.terms | escape }}”</p>
    {%- paginate search.results by 24 -%}
      {%- assign products = search.results | where: 'object_type', 'product' -%}
      {%- assign others = search.results | where: 'object_type', 'page' -%}
      {%- assign articles = search.results | where: 'object_type', 'article' -%}
      {%- if products.size > 0 -%}
        <h2 style="margin-top:var(--s-6)">Products</h2>
        <ul class="product-grid" role="list">{%- for product in products -%}<li>{% render 'product-card', product: product %}</li>{%- endfor -%}</ul>
      {%- endif -%}
      {%- if others.size > 0 or articles.size > 0 -%}
        <h2 style="margin-top:var(--s-7)">Pages</h2>
        <ul class="stack" style="padding-left:1.2em">
          {%- for r in others -%}<li><a href="{{ r.url }}">{{ r.title }}</a></li>{%- endfor -%}
          {%- for r in articles -%}<li><a href="{{ r.url }}">{{ r.title }}</a></li>{%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if search.results_count == 0 -%}
        <p>Try a simpler word like “pen”, “bowl”, or “board”, or <a href="{{ routes.all_products_collection_url }}">browse everything</a>. Can't find what you need? <a href="/pages/contact">Ask Ed</a>.</p>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>
{% schema %}
{ "name": "Search results" }
{% endschema %}
