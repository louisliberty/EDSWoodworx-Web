{%- comment -%}
  Collection page: Shop All, Pens, Bowls, Cutting Boards, and any future category.
  Filters stay off until the catalog is large enough to need them (setting below).
{%- endcomment -%}
{% render 'breadcrumbs' %}
<div class="page-width">
  <header class="collection-hero">
    <h1>{% if collection.handle == 'all' %}{{ section.settings.all_title }}{% else %}{{ collection.title }}{% endif %}</h1>
    {%- if collection.description != blank -%}
      <div class="rte">{{ collection.description }}</div>
    {%- elsif collection.handle == 'all' -%}
      <p>{{ section.settings.all_intro }}</p>
    {%- endif -%}
    <div class="mto-inline">
      {% render 'mto-badge' %}
      <p>Most pieces are made after you order. Current crafting time: <strong>{{ settings.lead_time_standard }}</strong> before shipping. <a href="/pages/made-to-order">How it works</a>.</p>
    </div>
  </header>

  {%- paginate collection.products by section.settings.per_page -%}
    <div class="toolbar">
      <p class="toolbar__count" role="status">{{ collection.products_count }} {{ collection.products_count | pluralize: 'piece', 'pieces' }}</p>
      {%- if section.settings.show_filters and collection.filters.size > 0 -%}
        <details class="filters">
          <summary class="button button--secondary">Filter</summary>
          <form method="get" class="stack" style="padding-top:var(--s-4)">
            {%- for filter in collection.filters -%}
              {%- if filter.type == 'list' -%}
                <fieldset><legend class="field__label">{{ filter.label }}</legend>
                  {%- for v in filter.values -%}
                    <label class="checkbox"><input type="checkbox" name="{{ v.param_name }}" value="{{ v.value }}"{% if v.active %} checked{% endif %}><span>{{ v.label }} ({{ v.count }})</span></label>
                  {%- endfor -%}
                </fieldset>
              {%- endif -%}
            {%- endfor -%}
            <input type="hidden" name="sort_by" value="{{ collection.sort_by | default: collection.default_sort_by }}">
            <div class="button-row"><button class="button" type="submit">Apply</button><a class="button button--secondary" href="{{ collection.url }}?sort_by={{ collection.sort_by }}">Clear</a></div>
          </form>
        </details>
      {%- endif -%}
      <form method="get" class="field" data-sort-form>
        {%- for filter in collection.filters -%}{%- for v in filter.active_values -%}<input type="hidden" name="{{ v.param_name }}" value="{{ v.value }}">{%- endfor -%}{%- endfor -%}
        <label for="SortBy">Sort by</label>
        <div style="display:flex;gap:var(--s-2)">
          <select id="SortBy" name="sort_by">
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            {%- assign allowed = 'manual,created-descending,price-ascending,price-descending' | split: ',' -%}
            {%- for option in collection.sort_options -%}
              {%- if allowed contains option.value -%}
                <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>
                  {%- case option.value -%}{%- when 'manual' -%}Featured{%- when 'created-descending' -%}Newest{%- when 'price-ascending' -%}Price: Low to High{%- when 'price-descending' -%}Price: High to Low{%- endcase -%}
                </option>
              {%- endif -%}
            {%- endfor -%}
          </select>
          <button type="submit" class="button button--secondary">Sort</button>
        </div>
      </form>
    </div>

    {%- if collection.products.size > 0 -%}
      <ul class="product-grid" role="list">
        {%- for product in collection.products -%}<li>{% render 'product-card', product: product %}</li>{%- endfor -%}
      </ul>
    {%- else -%}
      <div class="empty-state">
        <h2>New pieces are on the bench.</h2>
        <p>Nothing is listed here yet. Browse everything in the shop, or ask Ed about a custom piece.</p>
        <div class="button-row"><a class="button" href="{{ routes.all_products_collection_url }}">Shop all pieces</a><a class="button button--secondary" href="/pages/contact">Contact Ed</a></div>
      </div>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <nav aria-label="Pages">
        <ul class="pagination">
          {%- for part in paginate.parts -%}
            <li>{%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}<span class="visually-hidden"> (page)</span></a>{%- elsif part.title == paginate.current_page -%}<span aria-current="page">{{ part.title }}</span>{%- else -%}<span>{{ part.title }}</span>{%- endif -%}</li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>
<div style="height:var(--s-8)"></div>
{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "text", "id": "all_title", "label": "Shop All title", "default": "Shop all" },
    { "type": "textarea", "id": "all_intro", "label": "Shop All intro", "default": "Hand-turned pens, wooden bowls, and handmade cutting boards, each made to order in Ed’s workshop." },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 12, "max": 36, "step": 6, "default": 24 },
    { "type": "checkbox", "id": "show_filters", "label": "Show filters", "default": false, "info": "Leave off until you have roughly 20+ products. Set up filters in the Shopify Search & Discovery app." }
  ]
}
{% endschema %}
