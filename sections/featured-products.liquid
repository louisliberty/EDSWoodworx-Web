<section class="section" aria-labelledby="FeatHead-{{ section.id }}">
  <div class="page-width">
    <div class="section__head">
      <h2 id="FeatHead-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    {%- assign c = section.settings.collection -%}
    {%- if c != blank and c.products_count > 0 -%}
      <ul class="product-grid{% if section.settings.limit == 4 or section.settings.limit == 8 %} product-grid--4{% endif %}" role="list">
        {%- for product in c.products limit: section.settings.limit -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="owner-note"><strong>Owner note:</strong> choose a collection for this section in the theme editor (a collection named “Featured” works well). This note is only visible until you do.</p>
    {%- endif -%}
    <div class="section__foot"><a class="button button--secondary" href="{{ c.url | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}</a></div>
  </div>
</section>
{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the workshop" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "A few pieces Ed is making now." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Create a collection called Featured and add the products you want here. Reorder them inside the collection." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 3, "max": 8, "step": 1, "default": 3 },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Shop all pieces" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
