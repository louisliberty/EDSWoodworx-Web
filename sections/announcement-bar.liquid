{%- if section.settings.show -%}
<div class="announcement" role="region" aria-label="Announcement">
  <p>
    {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{{ section.settings.text }}</a>{%- else -%}{{ section.settings.text }}{%- endif -%}
    {%- if section.settings.text_2 != blank -%}<span aria-hidden="true"> &nbsp;|&nbsp; </span><span class="visually-hidden">. </span>{{ section.settings.text_2 }}{%- endif -%}
  </p>
</div>
{%- endif -%}
{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "checkbox", "id": "show", "label": "Show announcement", "default": true },
    { "type": "text", "id": "text", "label": "Message", "default": "Made to order in Ed's workshop" },
    { "type": "url", "id": "link", "label": "Link (optional)" },
    { "type": "text", "id": "text_2", "label": "Second message (optional)", "default": "Free shipping on orders over $[AMOUNT]", "info": "Delete this text if you don't offer free shipping. Never leave the [AMOUNT] placeholder live." }
  ]
}
{% endschema %}
