{%- comment -%} Homepage made-to-order explainer with the 3-step process. Reassuring, not apologetic. {%- endcomment -%}
<section class="section section--walnut" aria-labelledby="MtoHead-{{ section.id }}">
  <div class="page-width">
    <div class="section__head">
      {% render 'mto-badge' %}
      <h2 id="MtoHead-{{ section.id }}" style="margin-top:var(--s-4)">{{ section.settings.heading }}</h2>
      <p>{{ section.settings.body }}</p>
    </div>
    {%- if section.blocks.size > 0 -%}
      <ol class="steps">
        {%- for block in section.blocks -%}
          <li class="step" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
    <div class="section__foot">
      <p>Current crafting time: <strong>{{ settings.lead_time_standard }}</strong> before shipping.{% if settings.availability_enabled %} {{ settings.availability_text }}{% endif %}</p>
      {%- if section.settings.cta_label != blank -%}<a class="button button--light" href="{{ section.settings.cta_link | default: '/pages/made-to-order' }}">{{ section.settings.cta_label }}</a>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Made to order + steps",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made when you order. Built with care." },
    { "type": "textarea", "id": "body", "label": "Text", "default": "EDS WoodWorx is a small workshop, not a warehouse. Each order is crafted individually, so the grain, tone, and small details are uniquely yours." },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Learn About Made to Order" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Made to order + steps" }]
}
{% endschema %}
