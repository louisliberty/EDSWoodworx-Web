<section class="section{% if section.settings.background == 'walnut' %} section--walnut{% elsif section.settings.background == 'parchment' %} section--parchment{% endif %}" aria-labelledby="StepsHead-{{ section.id }}">
  <div class="page-width">
    <div class="section__head">
      <h2 id="StepsHead-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <ol class="steps">
      {%- for block in section.blocks -%}
        <li class="step" {{ block.shopify_attributes }}><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></li>
      {%- endfor -%}
    </ol>
    {%- if section.settings.show_times -%}
      <p style="margin-top:var(--s-6)">Current crafting time: <strong>{{ settings.lead_time_standard }}</strong>. With engraving or personalization: <strong>{{ settings.lead_time_custom }}</strong>. {{ settings.shipping_time_note }}</p>
      {%- if settings.availability_enabled -%}<p class="availability-note">{% render 'icon', name: 'ring-small' %}{{ settings.availability_text }}</p>{%- endif -%}
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Process steps",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How it works" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "show_times", "label": "Show current crafting times", "default": true },
    { "type": "select", "id": "background", "label": "Background", "default": "walnut", "options": [ { "value": "cream", "label": "Cream" }, { "value": "parchment", "label": "Parchment" }, { "value": "walnut", "label": "Walnut" } ] }
  ],
  "blocks": [ { "type": "step", "name": "Step", "settings": [ { "type": "text", "id": "title", "label": "Title" }, { "type": "textarea", "id": "text", "label": "Text" } ] } ],
  "max_blocks": 5,
  "presets": [{ "name": "Process steps" }]
}
{% endschema %}
