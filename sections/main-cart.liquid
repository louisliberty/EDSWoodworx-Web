<div class="page-width cart">
  <h1>Your cart</h1>
  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" id="CartForm" class="cart__layout" novalidate>
      <div>
        <ul class="cart-items" role="list">
          {%- for item in cart.items -%}
            <li class="cart-item">
              <a href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                {%- if item.image -%}
                  <div class="media media--square">{{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}</div>
                {%- else -%}{% render 'placeholder-media', label: item.product.title %}{%- endif -%}
              </a>
              <div>
                <h2 class="cart-item__title"><a href="{{ item.url }}">{{ item.product.title }}</a></h2>
                {%- unless item.product.has_only_default_variant -%}<p style="margin:0">{{ item.variant.title }}</p>{%- endunless -%}
                <p style="margin:var(--s-1) 0">{{ item.final_price | money }} each</p>
                {% render 'mto-badge', product: item.product %}
                {%- assign props = item.properties | default: empty -%}
                {%- if item.properties.size > 0 -%}
                  <dl class="cart-item__props">
                    {%- for p in item.properties -%}
                      {%- assign first_char = p.first | slice: 0 -%}
                      {%- if p.last != blank and first_char != '_' -%}<div><dt>{{ p.first }}:</dt> <dd>{{ p.last }}</dd></div>{%- endif -%}
                    {%- endfor -%}
                  </dl>
                {%- endif -%}
                <div class="cart-item__actions">
                  <div class="field" style="margin:0">
                    <label for="Updates-{{ item.key }}" class="visually-hidden">Quantity for {{ item.product.title }}</label>
                    <div class="qty" data-qty>
                      <button type="button" data-step="-1"><span aria-hidden="true">−</span><span class="visually-hidden">Decrease</span></button>
                      <input type="number" id="Updates-{{ item.key }}" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric">
                      <button type="button" data-step="1"><span aria-hidden="true">+</span><span class="visually-hidden">Increase</span></button>
                    </div>
                  </div>
                  <a href="{{ item.url_to_remove }}">Remove<span class="visually-hidden"> {{ item.product.title }}</span></a>
                </div>
              </div>
              <p class="cart-item__total">{{ item.final_line_price | money }}</p>
            </li>
          {%- endfor -%}
        </ul>
        <p style="margin-top:var(--s-4)"><button type="submit" name="update" class="button button--secondary">Update cart</button></p>

        {%- if settings.cart_gift_note -%}
          <div class="field" style="margin-top:var(--s-6)">
            <label for="CartNote">Note for Ed (optional)</label>
            <span class="field__hint" id="CartNoteHint">Gift details, a delivery date you're hoping for, or anything else Ed should know.</span>
            <textarea id="CartNote" name="note" rows="3" maxlength="500" aria-describedby="CartNoteHint">{{ cart.note }}</textarea>
          </div>
        {%- endif -%}
      </div>

      <aside class="summary" aria-labelledby="SummaryHead">
        <h2 id="SummaryHead">Order summary</h2>
        <div class="summary__row"><span>Subtotal</span><span>{{ cart.total_price | money_with_currency }}</span></div>
        {%- if cart.cart_level_discount_applications.size > 0 -%}
          {%- for d in cart.cart_level_discount_applications -%}<p class="summary__note">Discount: {{ d.title }} (−{{ d.total_allocated_amount | money }})</p>{%- endfor -%}
        {%- endif -%}
        <p class="summary__note">Shipping and taxes are calculated at checkout.{% if settings.free_shipping_note != blank %} {{ settings.free_shipping_note }}{% endif %}</p>
        {% render 'lead-time-note', context: 'cart' %}
        <button type="submit" name="checkout" class="button button--large button--full">Check out</button>
        <p class="summary__note" style="margin-top:var(--s-3)">Checkout is handled securely by Shopify.</p>
        <p class="summary__policies">
          {%- if shop.shipping_policy -%}<a href="{{ shop.shipping_policy.url }}">Shipping</a> · {% endif -%}
          {%- if shop.refund_policy -%}<a href="{{ shop.refund_policy.url }}">Returns</a> · {% endif -%}
          <a href="/pages/faq">FAQ</a>
        </p>
      </aside>
    </form>
  {%- else -%}
    <div class="empty-state">
      <p>{{ 'cart.empty' | t }}</p>
      <div class="button-row">
        <a class="button" href="{{ routes.all_products_collection_url }}">Shop all pieces</a>
        <a class="button button--secondary" href="/pages/made-to-order">How made to order works</a>
      </div>
    </div>
  {%- endif -%}
</div>
{% schema %}
{ "name": "Cart" }
{% endschema %}
