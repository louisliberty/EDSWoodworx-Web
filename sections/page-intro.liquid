{%- comment -%} Page heading (the page's single H1) with an optional intro and owner reminder. {%- endcomment -%}
<div class="page-width page-head">
  <h1>{{ section.settings.heading | default: page.title }}</h1>
  {%- if section.settings.intro != blank -%}<div class="rte"><p>{{ section.settings.intro }}</p></div>{%- endif -%}
  {%- if section.settings.owner_note != blank -%}<p class="owner-note"><strong>Owner note (remove before launch):</strong> {{ section.settings.owner_note }}</p>{%- endif -%}
</div>
{% schema %}
{
  "name": "Page heading",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the page title." },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    { "type": "textarea", "id": "owner_note", "label": "Owner note (visible on the site!)", "info": "Reminders to yourself. Clear this before launch." }
  ],
  "presets": [{ "name": "Page heading" }]
}
{% endschema %}
