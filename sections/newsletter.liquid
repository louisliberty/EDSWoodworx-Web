<section class="section section--tight{% if section.settings.background == 'walnut' %} section--walnut{% else %} section--parchment{% endif %}" aria-labelledby="NewsHead-{{ section.id }}">
  <div class="page-width">
    <div class="section__head" style="margin-bottom:var(--s-5)">
      <h2 id="NewsHead-{{ section.id }}">{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>
    {%- assign news_form_id = 'Newsletter-' | append: section.id -%}
    {%- form 'customer', id: news_form_id, class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-status form-status--success" role="status" tabindex="-1" autofocus>{% render 'icon', name: 'check' %} Thanks—you're on the list.</p>
      {%- else -%}
        {%- if form.errors -%}
          <p class="form-status form-status--error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
        <div class="field">
          <label for="NewsEmail-{{ section.id }}">Email address</label>
          <input type="email" id="NewsEmail-{{ section.id }}" name="contact[email]" autocomplete="email" required{% if form.errors %} aria-invalid="true"{% endif %}>
        </div>
        <button type="submit" class="button{% if section.settings.background == 'walnut' %} button--light{% endif %}">Sign up</button>
      {%- endif -%}
    {%- endform -%}
    <p class="newsletter__fine">{{ section.settings.fine_print }}{% if shop.privacy_policy %} <a href="{{ shop.privacy_policy.url }}">Privacy Policy</a>.{% endif %}</p>
  </div>
</section>
{% schema %}
{
  "name": "Email signup",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Notes from the workshop" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Get workshop updates, new releases, and occasional notes from EDS WoodWorx." },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "Unsubscribe anytime. We don't share your email." },
    { "type": "select", "id": "background", "label": "Background", "default": "parchment", "options": [ { "value": "parchment", "label": "Parchment" }, { "value": "walnut", "label": "Walnut" } ] }
  ],
  "presets": [{ "name": "Email signup" }]
}
{% endschema %}
