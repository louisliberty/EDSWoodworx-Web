<section class="section{% if section.settings.parchment %} section--parchment{% endif %}" aria-labelledby="BenHead-{{ section.id }}">
  <div class="page-width">
    <div class="section__head"><h2 id="BenHead-{{ section.id }}">{{ section.settings.heading }}</h2></div>
    <ul class="grid {% if section.blocks.size == 4 %}grid--4{% else %}grid--3{% endif %}" role="list" style="list-style:none;padding:0;margin:0">
      {%- for block in section.blocks -%}
        <li class="benefit" {{ block.shopify_attributes }}>
          {% render 'icon', name: block.settings.icon %}
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{% schema %}
{
  "name": "Benefits",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why EDS WoodWorx" },
    { "type": "checkbox", "id": "parchment", "label": "Tinted background", "default": true }
  ],
  "blocks": [
    { "type": "benefit", "name": "Benefit", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "hand", "options": [
        { "value": "hand", "label": "Hand" }, { "value": "grain", "label": "Wood grain" }, { "value": "bowl", "label": "Bowl" },
        { "value": "gift", "label": "Gift" }, { "value": "clock", "label": "Clock" }, { "value": "ring-small", "label": "Growth ring" } ] },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Benefits" }]
}
{% endschema %}
