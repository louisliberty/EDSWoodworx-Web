<section class="section{% if section.settings.compact %} section--tight{% endif %}{% if section.settings.parchment %} section--parchment{% endif %}"{% if section.settings.heading != blank %} aria-labelledby="RtHead-{{ section.id }}"{% endif %}>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}<h2 id="RtHead-{{ section.id }}">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="rte">{{ section.settings.text }}</div>
    {%- if section.settings.cta_label != blank -%}<p style="margin-top:var(--s-5)"><a class="button button--secondary" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a></p>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Text</p>" },
    { "type": "text", "id": "cta_label", "label": "Button" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "checkbox", "id": "parchment", "label": "Tinted background", "default": false },
    { "type": "checkbox", "id": "compact", "label": "Less space above and below", "default": false }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
