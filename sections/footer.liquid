<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        {% render 'icon', name: 'ring' %}
        <p class="wordmark"><span class="wordmark__eds">EDS</span> WoodWorx</p>
        <p>{{ section.settings.blurb }}</p>
        {%- unless settings.business_email contains '[' or settings.business_email == blank -%}
          <p><a href="mailto:{{ settings.business_email }}">{{ settings.business_email }}</a></p>
        {%- endunless -%}
        {%- if settings.business_location != blank -%}<p>{{ settings.business_location }}</p>{%- endif -%}
      </div>

      {%- for i in (1..2) -%}
        {%- capture key %}menu_{{ i }}{% endcapture -%}
        {%- capture title_key %}menu_{{ i }}_title{% endcapture -%}
        {%- assign m = section.settings[key] -%}
        {%- if m != blank -%}
          <nav aria-labelledby="FooterMenu{{ i }}">
            <h2 id="FooterMenu{{ i }}">{{ section.settings[title_key] }}</h2>
            <ul>{%- for link in linklists[m].links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}</ul>
          </nav>
        {%- endif -%}
      {%- endfor -%}

      <nav aria-labelledby="FooterPolicies">
        <h2 id="FooterPolicies">Policies</h2>
        <ul>
          {%- if shop.shipping_policy -%}<li><a href="{{ shop.shipping_policy.url }}">Shipping Policy</a></li>{%- endif -%}
          {%- if shop.refund_policy -%}<li><a href="{{ shop.refund_policy.url }}">Returns &amp; Refunds</a></li>{%- endif -%}
          {%- if shop.privacy_policy -%}<li><a href="{{ shop.privacy_policy.url }}">Privacy Policy</a></li>{%- endif -%}
          {%- if shop.terms_of_service -%}<li><a href="{{ shop.terms_of_service.url }}">Terms of Service</a></li>{%- endif -%}
          {%- if section.settings.accessibility_page != blank -%}<li><a href="{{ section.settings.accessibility_page.url }}">Accessibility Statement</a></li>{%- endif -%}
          <li data-cookie-prefs hidden><button type="button" class="link-button" style="color:#F3EBDD" onclick="window.privacyBanner && window.privacyBanner.showPreferences()">Cookie preferences</button></li>
        </ul>
      </nav>
    </div>

    <div class="site-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Handmade by Ed.</p>
      {%- liquid
        assign has_social = false
        if settings.social_instagram != blank or settings.social_facebook != blank or settings.social_pinterest != blank or settings.social_youtube != blank
          assign has_social = true
        endif
      -%}
      {%- if has_social -%}
        <ul class="social-links" aria-label="EDS WoodWorx on social media">
          {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" rel="noopener">{% render 'icon', name: 'instagram' %}<span class="visually-hidden">Instagram</span></a></li>{%- endif -%}
          {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" rel="noopener">{% render 'icon', name: 'facebook' %}<span class="visually-hidden">Facebook</span></a></li>{%- endif -%}
          {%- if settings.social_pinterest != blank -%}<li><a href="{{ settings.social_pinterest }}" rel="noopener">{% render 'icon', name: 'pinterest' %}<span class="visually-hidden">Pinterest</span></a></li>{%- endif -%}
          {%- if settings.social_youtube != blank -%}<li><a href="{{ settings.social_youtube }}" rel="noopener">{% render 'icon', name: 'youtube' %}<span class="visually-hidden">YouTube</span></a></li>{%- endif -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
  <script>
    // Show "Cookie preferences" only when Shopify's built-in privacy banner is active.
    document.addEventListener('DOMContentLoaded', function () {
      if (window.privacyBanner) { var li = document.querySelector('[data-cookie-prefs]'); if (li) li.hidden = false; }
    });
  </script>
</footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea", "id": "blurb", "label": "Short description", "default": "Hand-turned pens, wooden bowls, and cutting boards, made to order in Ed's workshop." },
    { "type": "text", "id": "menu_1_title", "label": "First menu heading", "default": "Shop" },
    { "type": "link_list", "id": "menu_1", "label": "First menu", "default": "footer", "info": "Suggested: Shop All, Pens, Bowls, Cutting Boards" },
    { "type": "text", "id": "menu_2_title", "label": "Second menu heading", "default": "Help" },
    { "type": "link_list", "id": "menu_2", "label": "Second menu", "info": "Suggested: Made to Order, FAQ, Shipping & Returns, Contact, Our Story" },
    { "type": "page", "id": "accessibility_page", "label": "Accessibility Statement page" }
  ]
}
{% endschema %}
