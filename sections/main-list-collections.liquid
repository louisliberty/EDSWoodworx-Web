<div class="page-width page-head"><h1>{{ section.settings.title }}</h1></div>
<div class="page-width" style="padding-bottom:var(--s-8)">
  <ul class="grid grid--3" role="list" style="list-style:none;padding:0;margin:0">
    {%- for c in collections -%}
      {%- unless c.handle == 'frontpage' or c.handle == 'featured' or c.products_count == 0 -%}
        <li><a class="category-tile" href="{{ c.url }}">
          {%- if c.featured_image -%}{% render 'responsive-image', image: c.featured_image, sizes: '(min-width: 750px) 33vw, 100vw', ratio: 'portrait', decorative: true %}{%- else -%}{% render 'placeholder-media', label: c.title, ratio: 'portrait' %}{%- endif -%}
          <h2 class="h3" style="font-size:var(--text-lg)">{{ c.title }}</h2>
          <span class="category-tile__cta">Shop {{ c.title | downcase }}</span>
        </a></li>
      {%- endunless -%}
    {%- endfor -%}
  </ul>
</div>
{% schema %}
{ "name": "Collections list", "settings": [ { "type": "text", "id": "title", "label": "Title", "default": "All categories" } ] }
{% endschema %}
