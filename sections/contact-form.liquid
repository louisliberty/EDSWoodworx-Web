<div class="page-width" style="padding-bottom:var(--s-8)">
  <div class="contact-layout">
    <div>
      {%- assign contact_form_id = 'ContactForm-' | append: section.id -%}
      {%- form 'contact', id: contact_form_id, class: 'form-narrow', data-validate: 'true' -%}
        {%- if form.posted_successfully? -%}
          <div class="form-status form-status--success" role="status" tabindex="-1" autofocus>
            <p style="margin:0"><strong>Message sent.</strong> Ed typically responds within {{ settings.response_time }}.</p>
          </div>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="form-status form-status--error" role="alert" tabindex="-1" autofocus>
            <p style="margin:0"><strong>Your message wasn't sent.</strong></p>
            <ul>{%- for field in form.errors -%}<li><a href="#{{ contact_form_id }}-{{ field }}">{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</a></li>{%- endfor -%}</ul>
          </div>
        {%- endif -%}
        <div class="form-status form-status--error" data-error-summary tabindex="-1" role="alert" hidden></div>
        <p class="field__hint">Fields marked <span class="required" aria-hidden="true">*</span><span class="visually-hidden">with an asterisk</span> are required.</p>

        <div class="field">
          <label for="{{ contact_form_id }}-name">Name <span class="required" aria-hidden="true">*</span></label>
          <input type="text" id="{{ contact_form_id }}-name" name="contact[name]" autocomplete="name" required value="{{ form.name }}">
          <p class="field__error" id="{{ contact_form_id }}-name-error" hidden>{% render 'icon', name: 'alert' %}<span></span></p>
        </div>
        <div class="field">
          <label for="{{ contact_form_id }}-email">Email <span class="required" aria-hidden="true">*</span></label>
          <input type="email" id="{{ contact_form_id }}-email" name="contact[email]" autocomplete="email" required value="{{ form.email }}" aria-describedby="{{ contact_form_id }}-email-error">
          <p class="field__error" id="{{ contact_form_id }}-email-error" hidden>{% render 'icon', name: 'alert' %}<span></span></p>
        </div>
        <div class="field">
          <label for="{{ contact_form_id }}-order">Order number (optional)</label>
          <span class="field__hint">Found in your order confirmation email, for example #1001.</span>
          <input type="text" id="{{ contact_form_id }}-order" name="contact[Order number]">
        </div>
        <div class="field">
          <label for="{{ contact_form_id }}-topic">Topic <span class="required" aria-hidden="true">*</span></label>
          <select id="{{ contact_form_id }}-topic" name="contact[Topic]" required>
            <option value="">Choose a topic</option>
            <option>Product question</option>
            <option>Custom request</option>
            <option>Existing order</option>
            <option>Wholesale or gifting inquiry</option>
            <option>Website issue</option>
            <option>Accessibility or accommodation request</option>
            <option>Other</option>
          </select>
          <p class="field__error" id="{{ contact_form_id }}-topic-error" hidden>{% render 'icon', name: 'alert' %}<span></span></p>
        </div>
        <div class="field">
          <label for="{{ contact_form_id }}-body">Message <span class="required" aria-hidden="true">*</span></label>
          <textarea id="{{ contact_form_id }}-body" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
          <p class="field__error" id="{{ contact_form_id }}-body-error" hidden>{% render 'icon', name: 'alert' %}<span></span></p>
        </div>
        <button type="submit" class="button button--large">Send message</button>
      {%- endform -%}
    </div>

    <aside class="contact-aside" aria-labelledby="ContactAsideHead">
      <h2 id="ContactAsideHead">{{ section.settings.aside_heading }}</h2>
      <p>Ed typically responds within {{ settings.response_time }}.</p>
      {%- unless settings.business_email contains '[' or settings.business_email == blank -%}
        <p>Email: <a href="mailto:{{ settings.business_email }}">{{ settings.business_email }}</a></p>
      {%- else -%}
        <p>Email: {{ settings.business_email }}</p>
      {%- endunless -%}
      <div class="rte">{{ section.settings.aside_text }}</div>
    </aside>
  </div>
</div>
{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "aside_heading", "label": "Side panel heading", "default": "Other ways to reach Ed" },
    { "type": "richtext", "id": "aside_text", "label": "Side panel text", "default": "<p>Have an idea for a special piece? Send a note with what you have in mind. Ed can't take on every request, but he reads each one and will tell you honestly whether it's a good fit.</p>" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
