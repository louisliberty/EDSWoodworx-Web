{%- comment -%}
  FAQ. Edit questions as blocks in the theme editor. FAQPage schema is generated from the same
  visible blocks, so structured data always matches what customers see.
{%- endcomment -%}
<section class="section" style="padding-top:var(--s-4)">
  <div class="page-width">
    <div class="accordion" style="max-width:52rem;margin-top:0">
      {%- for block in section.blocks -%}
        {%- if block.type == 'group' -%}
          <h2 {{ block.shopify_attributes }} style="margin:var(--s-7) 0 var(--s-3);{% if forloop.first %}margin-top:0{% endif %}">{{ block.settings.heading }}</h2>
        {%- else -%}
          <details {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}</summary>
            <div class="accordion__content rte">{{ block.settings.answer }}</div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.footer_text != blank -%}<div class="rte" style="margin-top:var(--s-7)">{{ section.settings.footer_text }}</div>{%- endif -%}
  </div>
</section>
{%- assign q_blocks = section.blocks | where: 'type', 'question' -%}
{%- if q_blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in q_blocks -%}
    { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}
{% schema %}
{
  "name": "FAQ",
  "settings": [ { "type": "richtext", "id": "footer_text", "label": "Text after questions" } ],
  "blocks": [
    { "type": "group", "name": "Topic heading", "settings": [ { "type": "text", "id": "heading", "label": "Heading" } ] },
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer" }
    ] }
  ],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
