<section class="section{% if section.settings.parchment %} section--parchment{% endif %}" aria-labelledby="GalHead-{{ section.id }}">
  <div class="page-width">
    <div class="section__head"><h2 id="GalHead-{{ section.id }}">{{ section.settings.heading }}</h2>{%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}</div>
    <ul class="gallery-grid" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <figure>
            {%- if block.settings.image -%}
              {% render 'responsive-image', image: block.settings.image, sizes: '(min-width: 750px) 33vw, 50vw', ratio: 'square' %}
            {%- else -%}
              {% render 'placeholder-media', label: block.settings.placeholder_label, ratio: 'square' %}
            {%- endif -%}
            {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption }}</figcaption>{%- endif -%}
          </figure>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{% schema %}
{
  "name": "Photo gallery",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "In the workshop" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "parchment", "label": "Tinted background", "default": false }
  ],
  "blocks": [ { "type": "photo", "name": "Photo", "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Add alt text in Content > Files describing what the photo shows." },
    { "type": "text", "id": "placeholder_label", "label": "Placeholder label", "default": "Workshop photo" },
    { "type": "text", "id": "caption", "label": "Caption" }
  ] } ],
  "max_blocks": 9,
  "presets": [{ "name": "Photo gallery" }]
}
{% endschema %}
