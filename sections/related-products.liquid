{%- comment -%}
  Related products. Priority: hand-picked list (metafield custom.related_products) > same collection.
{%- endcomment -%}
{%- liquid
  assign picks = product.metafields.custom.related_products.value
  assign source = nil
  if picks == blank
    for c in product.collections
      unless c.handle == 'all' or c.handle == 'featured' or c.handle == 'frontpage'
        assign source = c
        break
      endunless
    endfor
  endif
-%}
{%- if picks != blank or source != nil and source.products_count > 1 -%}
<section class="section section--parchment" aria-labelledby="RelHead-{{ section.id }}">
  <div class="page-width">
    <div class="section__head"><h2 id="RelHead-{{ section.id }}">{{ section.settings.heading }}</h2></div>
    <ul class="product-grid product-grid--4" role="list">
      {%- assign shown = 0 -%}
      {%- if picks != blank -%}
        {%- for p in picks limit: 4 -%}<li>{% render 'product-card', product: p %}</li>{%- endfor -%}
      {%- else -%}
        {%- for p in source.products -%}
          {%- if p.id != product.id and shown < 4 -%}
            <li>{% render 'product-card', product: p %}</li>
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Related products",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "You might also like" } ]
}
{% endschema %}
